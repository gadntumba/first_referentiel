    .item3 { grid-area: qrcode; }
        
    .item4 { grid-area: main;}
    
    .frame {
      /*width: 100%;*/
      width: 1063px;
      margin: auto;
      height: auto;
      position: absolute;
      /*max-width: 100%;*/
    }
    
    .item2 .photo {
      /*width: 100%;*/
      width: 100%;
      margin: auto;
      height: auto;
      /*max-width: 100%;*/
    }
    .item2 .photo-container {
        width: 80%;
        height: 100%;
        max-width: 200px;
        padding-top: 22px;
        margin: auto;
        /*border: 1px solid black;*/
    }
    
    
    .item3 .photo {
      /*width: 100%;*/
      width: 100%;
      margin: auto;
      height: auto;
      /*max-width: 100%;*/
    }
    .item3 .photo-container {
        width: 70%;
