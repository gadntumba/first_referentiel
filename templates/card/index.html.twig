      border: 1px solid black;
      background-color: rgba(255, 255, 255, 0.8);
      /*background-color: #2196F3;*/
      padding: 10px;
      width: 1063px;
      margin: auto;
      height: 591px;
    }
    
    .grid-container > div {
      background-color: rgba(255, 255, 255, 0.8);
      /*text-align: center;*/
      padding: 20px 0;
      font-size: 30px;
    }
    @media print 
    {
        @page
        {
            size: 3.6in 2.2in;
            size: portrait;
        }
    }
</style>
<link href='http://fonts.googleapis.com/css?family=Lato:400,700' rel='stylesheet' type='text/css'>
<link href="http://fonts.cdnfonts.com/css/ocr-a-extended" rel="stylesheet">
<link href="http://fonts.cdnfonts.com/css/nexa-bold" rel="stylesheet">
                
</head>
<!--body onload="window.print()"-->
<body>


    <div class="grid-container" id="capture">
        <img class="frame" height="591" src="/filigrane.png" alt="">
        <img class="frame" height="591" src="/filigrane_2.png" alt="">
        
      <div class="item1">
          <div class="me-container">
            <h1>REPUBLIQUE DEMOCRATIQUE DU CONGO</h1>
            <h4>Ministère de l'Agriculture, Pêche et Elevage et du Développement Rural</h4>
            <h2>CARTE DU PRODUCTEUR/PRODUCTRICE</h2>
            <div class="me-footer">
    
            </div>
          </div>
      </div>
      <div class="item2">
          <div class="photo-container">
            <img class="photo" height="54" src="{{data.photoPath}}" alt="">
          </div>
      </div>
      <div class="item3">
        <div class="photo-container">
            <img class="photo" height="54" src="/qrcode.png" alt="">
        </div>
      </div>  
      <div class="item4">
    
        <div class="me-container">
    
            <div class="nui">
                <label for="">NUI : </label>
                <span id="">{{data.personnalIdentityData.nui}}</span>
            </div>
            
            <div class="personnal-id">
                    
                <div class="main-item">
                    <label for="">Nom :</label>
                    <div id="" class="content">{{data.personnalIdentityData.lastName}}</div>
                </div>
                <div class="main-item">
                    <label for="">Prenom :</label>
                    <div id="" class="content">{{data.personnalIdentityData.firstName}}</div>
                </div>
                <div class="main-item">
                    <label for="" >Date et lieux de naissance :</label>
                    <div id="" class="content"> {{formattedDate}}</div>
                </div>
                <div class="main-item">
                    <label for="">Adresse :</label>
                    <div id="" class="content">
                        <div>{{address1}} </div>
                        <div>{{address2}}</div>
                    </div>
                </div>
                <div class="main-item">
                    <label for="">Profession :</label>
                    <div id="" class="content">Agriculteur</div>
                </div>
    
            </div>
            <div class="logo">
                <img class="flag-logo" src="/cd.jpg" height="50" alt="ggg">
                <img src="/LOGO-PNDA.png" height="100" alt="ggg">
            </div>
            <div class="armoiries">
                <img class="armoiries-img" src="/armoirie1.png" height="300" alt="ggg">
            </div>
        </div>
      </div>
    </div>
    
    
    </body>
<script src="/canevaHttml.js"></script>
<script>
    console.log(window)
    html2canvas(document.querySelector("#capture"), {width:1063, height:650}).then(canvas => {
        console.log(canvas.toString())
        var data = canvas.toDataURL();
        var prev = window.location.href;
        window.location.href = data.replace("image/png", "image/octet-stream");
        window.location.href = prev;
        document.body.appendChild(canvas)

        canvas.toBlob(function (blob) {
            var url  = window.URL.createObjectURL(blob);
            window.location.assign(url);
        });
    });
</script>

</body>
</html>